---
import Layout from '../layouts/Layout.astro';
import UserMenu from '../components/UserMenu.astro';
import { verifyAccessToken } from '../lib/auth';

const env = Astro.locals.runtime.env;
const APP_NAME: string = env.APP_NAME ?? 'Veil';
const ACCENT_COLOR: string = env.ACCENT_COLOR ?? '#6d83f2';

let userEmail = 'unknown';
try {
  const payload = await verifyAccessToken(Astro.request, env);
  userEmail = payload.email;
} catch {
  return Astro.redirect('/', 302);
}

const db = env.DB;
const { results: settingsRows } = await db
  .prepare('SELECT key, value FROM settings')
  .all();

const settings: Record<string, string | null> = {
  forward_to: null,
  reject_message: null,
};

for (const row of settingsRows as { key: string; value: string }[]) {
  settings[row.key] = row.value;
}

const retentionDays = settings['log_retention_days'] ?? '90';
---

<Layout title={`Settings | ${APP_NAME}`} accentColor={ACCENT_COLOR}>
  <div class="settings-header">
    <div class="header-top-row">
      <a href="/" class="back-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Aliases
      </a>
      <UserMenu userEmail={userEmail} teamDomain={env.CF_ACCESS_TEAM_DOMAIN} />
    </div>
    <h1>Settings</h1>
    <p class="settings-subtitle">Configure email forwarding and rejection behavior</p>
  </div>

  <form id="settings-form" class="settings-form">
    <div class="form-group">
      <label for="forward_to">Forward To</label>
      <p class="form-hint">Email address to forward all incoming mail to. Must be verified in Cloudflare Email Routing.</p>
      <input
        type="email"
        id="forward_to"
        name="forward_to"
        placeholder="you@example.com"
        value={settings.forward_to ?? ''}
        autocomplete="off"
      />
    </div>

    <div class="form-group">
      <label for="reject_message">Reject Message</label>
      <p class="form-hint">SMTP message sent back to the sender when an email is blocked or rejected.</p>
      <input
        type="text"
        id="reject_message"
        name="reject_message"
        placeholder="This address is no longer active"
        value={settings.reject_message ?? ''}
        autocomplete="off"
      />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary" id="save-btn">
        <span class="spinner" id="save-spinner"></span>
        <span id="save-label">Save Settings</span>
      </button>
      <div class="save-status" id="save-status"></div>
    </div>
  </form>

<div class="info-box">
  <strong>Note:</strong> Settings stored here take precedence over environment variables. Set forwarding address to save email forwarding. Leave reject message empty to use the environment variable default (if set).
</div>

<div class="settings-section">
  <h2>Log management</h2>
  <p class="settings-subtitle">Email activity logs are kept for the configured number of days.</p>

  <div class="settings-form" style="margin-top: 1rem;">
    <div class="form-group">
      <label for="log_retention_days">Retention period (days)</label>
      <p class="form-hint">Logs older than this are automatically deleted each night at 2 AM UTC.</p>
      <input
        type="number"
        id="log_retention_days"
        name="log_retention_days"
        min="1"
        max="3650"
        value={retentionDays}
      />
    </div>
    <div class="form-actions">
      <button type="button" class="btn-primary" id="save-retention-btn">Save</button>
      <div class="save-status" id="retention-status"></div>
    </div>
  </div>

  <div class="danger-zone">
    <h3>Clear logs</h3>
    <div class="danger-row">
      <div>
        <strong>Delete logs older than 30 days</strong>
        <p class="form-hint">Permanently removes log entries more than 30 days old.</p>
      </div>
      <button type="button" class="btn-danger-outline" id="clear-30d-btn">Clear 30d+</button>
    </div>
    <div class="danger-row">
      <div>
        <strong>Delete all logs</strong>
        <p class="form-hint">Permanently removes every log entry.</p>
      </div>
      <button type="button" class="btn-danger-outline" id="clear-all-btn">Clear all</button>
    </div>
  </div>
</div>
</Layout>

<style>
  .settings-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 1rem;
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--accent);
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .settings-subtitle {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .settings-form {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group:last-of-type {
    margin-bottom: 2rem;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .form-hint {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .form-group input {
    width: 100%;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    color: var(--text-primary);
    font-size: 1rem;
    transition: all var(--transition);
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .form-group input::placeholder {
    color: var(--text-muted);
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all var(--transition);
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--accent-light);
    transform: translateY(-1px);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .save-status {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .save-status.success {
    color: #4ade80;
  }

  .save-status.error {
    color: #f87171;
  }

  .info-box {
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border-color));
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .info-box strong {
    color: var(--text-primary);
  }

  .header-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .settings-section {
    margin-top: 2rem;
  }

  .settings-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .danger-zone {
    margin-top: 2rem;
    border: 1px solid color-mix(in srgb, #ef4444 30%, var(--border-color));
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .danger-zone h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #f87171;
    margin-bottom: 1rem;
  }

  .danger-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    border-top: 1px solid var(--border-color);
  }

  .danger-row:first-of-type {
    border-top: none;
  }

  .danger-row strong {
    color: var(--text-primary);
    font-size: 0.9rem;
  }

  .btn-danger-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid color-mix(in srgb, #ef4444 40%, var(--border-color));
    color: #f87171;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    transition: all var(--transition);
    white-space: nowrap;
    cursor: pointer;
  }

  .btn-danger-outline:hover {
    border-color: #ef4444;
    background: color-mix(in srgb, #ef4444 10%, transparent);
  }
</style>

<script>
  const form = document.getElementById('settings-form');
  const saveBtn = document.getElementById('save-btn');
  const saveSpinner = document.getElementById('save-spinner');
  const saveLabel = document.getElementById('save-label');
  const saveStatus = document.getElementById('save-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const forwardTo = document.getElementById('forward_to').value.trim();
    const rejectMessage = document.getElementById('reject_message').value.trim();

    saveBtn.disabled = true;
    saveSpinner.style.display = 'block'
    saveLabel.textContent = 'Saving…';

    saveStatus.textContent = '';
    saveStatus.className = 'save-status';

    try {
      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          forward_to: forwardTo,
          reject_message: rejectMessage
        })
      });

      const data = await res.json();

      if (res.ok) {
        saveStatus.textContent = 'Settings saved successfully';
        saveStatus.className = 'save-status success'
      } else {
        saveStatus.textContent = data.error ?? 'Failed to save settings'
        saveStatus.className = 'save-status error'
      }
    } catch (err) {
      saveStatus.textContent = 'Network error'
      saveStatus.className = 'save-status error'
    } finally {
      saveBtn.disabled = false
      saveSpinner.style.display = 'none'
      saveLabel.textContent = 'Save Settings'
    }
  });

  document.getElementById('save-retention-btn')?.addEventListener('click', async () => {
    const days = (document.getElementById('log_retention_days') as HTMLInputElement).value;
    const status = document.getElementById('retention-status')!;
    const res = await fetch('/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ log_retention_days: days }),
    });
    status.textContent = res.ok ? 'Saved.' : 'Failed to save.';
    status.className = `save-status ${res.ok ? 'success' : 'error'}`;
  });

  async function clearLogs(before?: number) {
    const url = before ? `/api/logs?before=${before}` : '/api/logs';
    const res = await fetch(url, { method: 'DELETE' });
    return res.ok;
  }

  document.getElementById('clear-30d-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (btn.dataset.confirming !== 'true') {
      btn.textContent = 'Confirm?';
      btn.dataset.confirming = 'true';
      setTimeout(() => { btn.textContent = 'Clear 30d+'; delete btn.dataset.confirming; }, 3000);
      return;
    }
    btn.disabled = true;
    const cutoff = Date.now() - 30 * 86400 * 1000;
    await clearLogs(cutoff);
    btn.textContent = 'Done';
    setTimeout(() => { btn.textContent = 'Clear 30d+'; btn.disabled = false; }, 2000);
  });

  document.getElementById('clear-all-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (btn.dataset.confirming !== 'true') {
      btn.textContent = 'Confirm?';
      btn.dataset.confirming = 'true';
      setTimeout(() => { btn.textContent = 'Clear all'; delete btn.dataset.confirming; }, 3000);
      return;
    }
    btn.disabled = true;
    await clearLogs();
    btn.textContent = 'Done';
    setTimeout(() => { btn.textContent = 'Clear all'; btn.disabled = false; }, 2000);
  });
</script>
