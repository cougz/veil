---
import Layout from '../layouts/Layout.astro';
import UserMenu from '../components/UserMenu.astro';
import { verifyAccessToken } from '../lib/auth';
import { formatDate } from '../lib/dates';

const env = Astro.locals.runtime.env;
const APP_NAME: string        = env.APP_NAME        ?? 'Veil';
const APP_DESCRIPTION: string = env.APP_DESCRIPTION ?? 'Wildcard email aliasing. Forward, filter, and burn addresses without exposing your inbox.';
const ACCENT_COLOR: string    = env.ACCENT_COLOR    ?? '#6d83f2';
const DOMAIN: string          = env.DOMAIN          ?? 'yourdomain.com';

let userEmail = 'unknown';
try {
  const payload = await verifyAccessToken(Astro.request, env);
  userEmail = payload.email;
} catch {
  return new Response('Unauthorized', { status: 401 });
}

const db = env.DB;
const { results: aliases } = await db
  .prepare('SELECT * FROM aliases ORDER BY last_seen DESC LIMIT 500')
  .all();

const total   = aliases.length;
const active  = aliases.filter((a: any) => a.status === 'active').length;
const blocked = aliases.filter((a: any) => a.status === 'blocked').length;

const now = Math.floor(Date.now() / 1000);
const ts7d  = now - 7 * 86400;
const ts30d = now - 30 * 86400;
const ts6mo = now - 180 * 86400;
const ts12mo = now - 365 * 86400;

const emailRow = await db.prepare(`
  SELECT
    COUNT(*) as total_all,
    SUM(CASE WHEN event = 'forwarded' THEN 1 ELSE 0 END) as forwarded_all,
    SUM(CASE WHEN event = 'blocked' THEN 1 ELSE 0 END) as blocked_all,
    SUM(CASE WHEN timestamp >= ?1 THEN 1 ELSE 0 END) as total_7d,
    SUM(CASE WHEN timestamp >= ?1 AND event = 'forwarded' THEN 1 ELSE 0 END) as forwarded_7d,
    SUM(CASE WHEN timestamp >= ?1 AND event = 'blocked' THEN 1 ELSE 0 END) as blocked_7d,
    SUM(CASE WHEN timestamp >= ?2 THEN 1 ELSE 0 END) as total_30d,
    SUM(CASE WHEN timestamp >= ?2 AND event = 'forwarded' THEN 1 ELSE 0 END) as forwarded_30d,
    SUM(CASE WHEN timestamp >= ?2 AND event = 'blocked' THEN 1 ELSE 0 END) as blocked_30d,
    SUM(CASE WHEN timestamp >= ?3 THEN 1 ELSE 0 END) as total_6mo,
    SUM(CASE WHEN timestamp >= ?3 AND event = 'forwarded' THEN 1 ELSE 0 END) as forwarded_6mo,
    SUM(CASE WHEN timestamp >= ?3 AND event = 'blocked' THEN 1 ELSE 0 END) as blocked_6mo,
    SUM(CASE WHEN timestamp >= ?4 THEN 1 ELSE 0 END) as total_12mo,
    SUM(CASE WHEN timestamp >= ?4 AND event = 'forwarded' THEN 1 ELSE 0 END) as forwarded_12mo,
    SUM(CASE WHEN timestamp >= ?4 AND event = 'blocked' THEN 1 ELSE 0 END) as blocked_12mo
  FROM logs
`).bind(ts7d, ts30d, ts6mo, ts12mo).first();

const e = emailRow as any;
const emailStatsData = {
  '7d':   { total: e?.total_7d   ?? 0, forwarded: e?.forwarded_7d   ?? 0, blocked: e?.blocked_7d   ?? 0 },
  '30d':  { total: e?.total_30d  ?? 0, forwarded: e?.forwarded_30d  ?? 0, blocked: e?.blocked_30d  ?? 0 },
  '6mo':  { total: e?.total_6mo  ?? 0, forwarded: e?.forwarded_6mo  ?? 0, blocked: e?.blocked_6mo  ?? 0 },
  '12mo': { total: e?.total_12mo ?? 0, forwarded: e?.forwarded_12mo ?? 0, blocked: e?.blocked_12mo ?? 0 },
  'all':  { total: e?.total_all  ?? 0, forwarded: e?.forwarded_all  ?? 0, blocked: e?.blocked_all  ?? 0 },
};
---

<Layout title={APP_NAME} accentColor={ACCENT_COLOR}>
<div class="page-header">
    <UserMenu userEmail={userEmail} teamDomain={env.CF_ACCESS_TEAM_DOMAIN} />
  </div>

  <section class="hero">
    <h1 class="hero-title">Welcome to {APP_NAME}</h1>
    <p class="hero-subtitle">
      {APP_DESCRIPTION}
      <br>
      <span class="powered-by">
        Powered by
        <svg viewBox="0 0 50 50" width="18" height="18" fill="currentColor" aria-hidden="true" class="cf-workers-icon">
          <path d="m18.63 37.418-9.645-12.9 9.592-12.533-1.852-2.527L5.917 23.595l-.015 1.808 10.86 14.542z"></path>
          <path d="M21.997 6.503h-3.712l13.387 18.3-13.072 17.7h3.735L35.4 24.81z"></path>
          <path d="M29.175 6.503h-3.758l13.598 18.082-13.598 17.918h3.765l12.908-17.01v-1.808z"></path>
        </svg>
        <a href="https://developers.cloudflare.com/workers/" target="_blank" rel="noopener">Cloudflare Workers</a>
      </span>
    </p>
  </section>

  <div class="stats-row">
    <div class="stat-card">
      <span class="stat-number">{total}</span>
      <span class="stat-label">Total Aliases</span>
    </div>
    <div class="stat-card">
      <span class="stat-number">{active}</span>
      <span class="stat-label">Enabled</span>
    </div>
    <div class="stat-card">
      <span class="stat-number">{blocked}</span>
      <span class="stat-label">Disabled</span>
    </div>
  </div>

  <hr class="divider" />

  <div class="email-stats-header">
    <span class="options-label">Email Activity</span>
    <div class="seg-group" id="range-group">
      <div class="seg-indicator"></div>
      <button class="seg" data-range="7d">7d</button>
      <button class="seg" data-range="30d">30d</button>
      <button class="seg active" data-range="6mo">6mo</button>
      <button class="seg" data-range="12mo">12mo</button>
      <button class="seg" data-range="all">All</button>
    </div>
  </div>
  <div class="stats-row">
    <div class="stat-card">
      <span class="stat-number" id="stat-forwarded">{e?.forwarded_6mo ?? 0}</span>
      <span class="stat-label">Forwarded</span>
    </div>
    <div class="stat-card">
      <span class="stat-number" id="stat-blocked">{e?.blocked_6mo ?? 0}</span>
      <span class="stat-label">Blocked</span>
    </div>
    <div class="stat-card">
      <span class="stat-number" id="stat-total">{e?.total_6mo ?? 0}</span>
      <span class="stat-label">Total Processed</span>
    </div>
  </div>

  <hr class="divider" />

  <div class="options-row">
    <span class="options-label">Filter:</span>
    <div class="seg-group" id="filter-group">
      <div class="seg-indicator"></div>
      <button class="seg active" data-filter="all">All <span class="seg-count">{total}</span></button>
      <button class="seg" data-filter="active">Enabled <span class="seg-count">{active}</span></button>
      <button class="seg" data-filter="blocked">Disabled <span class="seg-count">{blocked}</span></button>
    </div>
    <input type="text" class="search-input" id="alias-search" placeholder="Search aliases..." />
    <button class="btn-new-alias" id="btn-new-alias">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      New alias
    </button>
    <a href="/api/aliases/export" class="btn-export" download="aliases.csv">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Export CSV
    </a>
  </div>

  <section class="table-section">
    <div class="table-wrapper">
      <table class="alias-table" id="alias-table">
        <thead>
          <tr>
            <th class="sortable" data-sort="address">Address <span class="sort-indicator"></span></th>
            <th class="sortable" data-sort="first_seen">First Seen <span class="sort-indicator"></span></th>
            <th class="sortable" data-sort="last_seen">Last Seen <span class="sort-indicator"></span></th>
            <th class="sortable" data-sort="mail_count">Mails <span class="sort-indicator"></span></th>
            <th class="sortable" data-sort="expires_at">Expires <span class="sort-indicator"></span></th>
            <th class="sortable" data-sort="status">Status <span class="sort-indicator"></span></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="alias-tbody">
          {aliases.map((alias: any) => (
            <tr data-address={alias.address} data-status={alias.status} data-first-seen={alias.first_seen} data-last-seen={alias.last_seen} data-mail-count={alias.mail_count} data-expires-at={alias.expires_at ?? ''} class="alias-row">
              <td class="alias-address">
                <code>{alias.address}</code>
              </td>
              <td class="alias-date">{formatDate(alias.first_seen)}</td>
              <td class="alias-date">{formatDate(alias.last_seen)}</td>
              <td class="alias-count">{alias.mail_count}</td>
              <td class="alias-date">
                {alias.expires_at
                  ? formatDate(alias.expires_at)
                  : <span style="color: var(--text-muted); font-size: 0.8rem;">Never</span>}
              </td>
              <td>
                <span class={`badge ${alias.status === 'active' ? 'badge-active' : 'badge-blocked'}`}>
                  {alias.status === 'active' ? 'Enabled' : 'Disabled'}
                </span>
              </td>
              <td class="alias-actions">
                <button class="btn-sm btn-toggle" data-address={alias.address} data-status={alias.status}>
                  {alias.status === 'active' ? 'Disable' : 'Enable'}
                </button>
                <button class="btn-sm btn-delete btn-danger" data-address={alias.address}>
                  Delete
                </button>
                <a
                  class="btn-sm btn-logs"
                  href={`/logs?search=${encodeURIComponent(alias.address)}`}
                  title="View logs for this alias"
                >
                  Logs
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {aliases.length === 0 && (
        <div class="empty-state">
          No aliases yet. Send an email to any address to get started.
        </div>
      )}
    </div>
  </section>

  <div class="modal-overlay" id="alias-modal-overlay" aria-hidden="true" data-domain={DOMAIN}>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-header">
        <h2 id="modal-title">New alias</h2>
        <button class="modal-close" id="alias-modal-close" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="new-alias-address">Address</label>
          <div class="input-suffix-wrap">
            <input type="text" id="new-alias-local" placeholder="anything" autocomplete="off" />
            <span class="input-suffix">@{DOMAIN}</span>
          </div>
        </div>
        <div class="form-group">
          <label for="new-alias-expires">Expires (optional)</label>
          <input type="date" id="new-alias-expires" />
          <p class="form-hint">Leave blank for a permanent alias.</p>
        </div>
        <div class="modal-error" id="alias-modal-error" hidden></div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="alias-modal-cancel">Cancel</button>
        <button class="btn-primary-sm" id="alias-modal-submit">Create alias</button>
      </div>
    </div>
  </div>

</Layout>

<style>
  .page-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1rem;
  }

  .hero {
    text-align: center;
    padding: 80px 0 40px;
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 16px;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto;
  }

  .powered-by {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85em;
    color: var(--text-muted);
    margin-top: 8px;
  }

  .powered-by svg {
    color: var(--accent);
    vertical-align: text-bottom;
  }

  .powered-by a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition);
  }

  .powered-by a:hover {
    color: var(--accent-light);
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 2rem 0;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .email-stats-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .stats-row:last-of-type {
    margin-bottom: 2rem;
  }

  @media (max-width: 600px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
  }

  .stat-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-align: center;
    transition: all var(--transition);
  }

  .stat-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-accent);
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .options-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .search-input {
    margin-left: auto;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.875rem;
    min-width: 200px;
    transition: all var(--transition);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .btn-export {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition);
    white-space: nowrap;
  }

  .btn-export:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .btn-new-alias {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--accent);
    border: none;
    color: white;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    transition: all var(--transition);
    white-space: nowrap;
    cursor: pointer;
  }
  .btn-new-alias:hover { background: var(--accent-dark); }

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 2000;
    align-items: center;
    justify-content: center;
  }
  .modal-overlay.visible { display: flex; }
  .modal {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    width: 440px;
    max-width: 95vw;
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .modal-header h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.4rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 0.2rem;
  }
  .modal-body { padding: 1.25rem 1.5rem; }
  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border-color);
  }
  .form-group { margin-bottom: 1.25rem; }
  .form-group label {
    display: block;
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }
  .form-hint {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-top: 0.35rem;
  }
  .input-suffix-wrap {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    overflow: hidden;
  }
  .input-suffix-wrap input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 0.6rem 0.75rem;
    color: var(--text-primary);
    font-size: 0.9rem;
  }
  .input-suffix {
    padding: 0.6rem 0.75rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    background: var(--bg-tertiary);
    border-left: 1px solid var(--border-color);
    white-space: nowrap;
  }
  #new-alias-expires {
    width: 100%;
    padding: 0.6rem 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.9rem;
  }
  .modal-error {
    color: #f87171;
    font-size: 0.85rem;
    margin-top: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: color-mix(in srgb, #ef4444 10%, transparent);
    border-radius: var(--radius-sm);
  }
  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .btn-primary-sm {
    background: var(--accent);
    border: none;
    color: white;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
  }
  .btn-primary-sm:hover:not(:disabled) { background: var(--accent-dark); }
  .btn-primary-sm:disabled { opacity: 0.5; cursor: not-allowed; }

  .options-label {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .seg-group {
    display: inline-flex;
    background: color-mix(in srgb, var(--text-primary) 5%, transparent);
    border-radius: 0.5rem;
    padding: 2px;
    position: relative;
  }

  .seg {
    position: relative;
    z-index: 1;
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 2px 10px;
    border-radius: calc(0.5rem - 2px);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    cursor: pointer;
    transition: color 200ms ease;
    white-space: nowrap;
  }

  .seg:hover {
    color: var(--text-primary);
  }

  .seg.active {
    color: var(--text-primary);
  }

  .seg-count {
    font-size: 0.6rem;
    opacity: 0.5;
    margin-left: 1px;
    font-weight: 600;
    vertical-align: super;
  }

  .seg-indicator {
    position: absolute;
    top: 2px;
    height: calc(100% - 4px);
    background: color-mix(in srgb, var(--text-primary) 10%, transparent);
    border-radius: calc(0.5rem - 2px);
    transition: all 200ms ease;
    z-index: 0;
    pointer-events: none;
  }

  .table-section {
    margin-bottom: 2rem;
  }

  .table-wrapper {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    overflow-x: auto;
  }

  .alias-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 700px;
  }

  .alias-table th {
    background: var(--bg-tertiary);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }

  .alias-table th.sortable {
    cursor: pointer;
    user-select: none;
    transition: color var(--transition);
  }

  .alias-table th.sortable:hover {
    color: var(--text-primary);
  }

  .sort-indicator {
    display: inline-block;
    margin-left: 0.25rem;
    opacity: 0.5;
  }

  .sort-indicator::after {
    content: '↕';
  }

  th.sort-asc .sort-indicator::after {
    content: '↑';
    opacity: 1;
  }

  th.sort-desc .sort-indicator::after {
    content: '↓';
    opacity: 1;
  }

  .alias-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    vertical-align: middle;
  }

  .alias-row {
    transition: background var(--transition);
  }

  .alias-row:hover {
    background: var(--bg-tertiary);
  }

  .alias-row:last-child td {
    border-bottom: none;
  }

  .alias-address code {
    color: var(--text-primary);
    font-weight: 500;
  }

  .alias-date {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .alias-count {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-active {
    background: color-mix(in srgb, #22c55e 15%, transparent);
    color: #4ade80;
    border: 1px solid color-mix(in srgb, #22c55e 30%, transparent);
  }

  .badge-blocked {
    background: color-mix(in srgb, #ef4444 15%, transparent);
    color: #f87171;
    border: 1px solid color-mix(in srgb, #ef4444 30%, transparent);
  }

  .alias-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-sm {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    transition: all var(--transition);
    white-space: nowrap;
  }

  .btn-sm:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-sm:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-toggle:hover:not(:disabled) {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .btn-danger:hover:not(:disabled) {
    border-color: #ef4444;
    color: #f87171;
    background: color-mix(in srgb, #ef4444 10%, transparent);
  }

  .btn-logs {
    text-decoration: none;
    text-align: center;
  }
  .btn-logs:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 56px 0 32px;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }

    .stat-number {
      font-size: 2rem;
    }

    .search-bar {
      flex-wrap: wrap;
    }

    .search-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 40px 0 24px;
    }

    .hero-title {
      font-size: 1.75rem;
    }
  }
</style>

<script define:vars={{ emailStats: emailStatsData }}>
  async function apiFetch(path, method = 'GET', body = null) {
    const opts = {
      method,
      headers: {
        'Content-Type': 'application/json'
      }
    };
    if (body) opts.body = JSON.stringify(body);
    const res = await fetch(path, opts);
    return res;
  }

  let currentSort = { column: null, asc: true };
  let currentFilter = 'all';
  let currentSearch = '';

  function applyFiltersAndSort() {
    const rows = Array.from(document.querySelectorAll('.alias-row'));
    rows.forEach(row => {
      const matchesFilter = currentFilter === 'all' || row.dataset.status === currentFilter;
      const matchesSearch = !currentSearch || row.dataset.address.toLowerCase().includes(currentSearch.toLowerCase());
      row.style.display = (matchesFilter && matchesSearch) ? '' : 'none';
    });
    if (currentSort.column) {
      sortTable(currentSort.column, currentSort.asc);
    }
  }

  function moveIndicator(group: HTMLElement, activeBtn: HTMLElement) {
    const indicator = group.querySelector('.seg-indicator') as HTMLElement;
    if (!indicator || !activeBtn) return;
    const groupRect = group.getBoundingClientRect();
    const btnRect = activeBtn.getBoundingClientRect();
    indicator.style.left = `${btnRect.left - groupRect.left}px`;
    indicator.style.width = `${btnRect.width}px`;
    indicator.style.transform = 'none';
  }

  function initSegGroup(groupId: string, onActivate: (btn: HTMLElement) => void) {
    const group = document.getElementById(groupId);
    if (!group) return;
    const btns = group.querySelectorAll<HTMLElement>('.seg');
    const activeBtn = group.querySelector<HTMLElement>('.seg.active');
    if (activeBtn) moveIndicator(group, activeBtn);
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        moveIndicator(group, btn);
        onActivate(btn);
      });
    });
  }

  initSegGroup('filter-group', (btn) => {
    currentFilter = btn.dataset.filter ?? 'all';
    applyFiltersAndSort();
  });

  const searchInput = document.getElementById('alias-search');
  searchInput.addEventListener('input', (e) => {
    currentSearch = e.target.value;
    applyFiltersAndSort();
  });

  function sortTable(column, asc) {
    const tbody = document.getElementById('alias-tbody');
    const rows = Array.from(tbody.querySelectorAll('.alias-row'));
    
    rows.sort((a, b) => {
      let valA, valB;
      switch (column) {
        case 'address':
          valA = a.dataset.address.toLowerCase();
          valB = b.dataset.address.toLowerCase();
          break;
        case 'first_seen':
          valA = parseInt(a.dataset.firstSeen, 10);
          valB = parseInt(b.dataset.firstSeen, 10);
          break;
        case 'last_seen':
          valA = parseInt(a.dataset.lastSeen, 10);
          valB = parseInt(b.dataset.lastSeen, 10);
          break;
        case 'mail_count':
          valA = parseInt(a.dataset.mailCount, 10);
          valB = parseInt(b.dataset.mailCount, 10);
          break;
        case 'status':
          valA = a.dataset.status;
          valB = b.dataset.status;
          break;
        case 'expires_at':
          valA = parseInt(a.dataset.expiresAt || '0', 10);
          valB = parseInt(b.dataset.expiresAt || '0', 10);
          break;
        default:
          return 0;
      }
      if (typeof valA === 'string') {
        return asc ? valA.localeCompare(valB) : valB.localeCompare(valA);
      }
      return asc ? valA - valB : valB - valA;
    });

    rows.forEach(row => tbody.appendChild(row));
  }

  document.querySelectorAll('th.sortable').forEach(th => {
    th.addEventListener('click', () => {
      const column = th.dataset.sort;
      document.querySelectorAll('th.sortable').forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
      
      if (currentSort.column === column) {
        currentSort.asc = !currentSort.asc;
      } else {
        currentSort.column = column;
        currentSort.asc = true;
      }
      
      th.classList.add(currentSort.asc ? 'sort-asc' : 'sort-desc');
      sortTable(column, currentSort.asc);
    });
  });

  function attachToggleListeners() {
    document.querySelectorAll('.btn-toggle').forEach(btn => {
      btn.removeEventListener('click', handleToggle);
      btn.addEventListener('click', handleToggle);
    });
  }

  async function handleToggle(e) {
    const btn = e.currentTarget;
    const address = btn.dataset.address;
    const currentStatus = btn.dataset.status;
    const newStatus = currentStatus === 'active' ? 'blocked' : 'active';

    btn.disabled = true;
    btn.textContent = '...';

    const res = await apiFetch(
      `/api/aliases/${encodeURIComponent(address)}`,
      'PATCH',
      { status: newStatus }
    );

    if (res.ok) {
      const row = document.querySelector(`tr[data-address="${address}"]`);
      row.dataset.status = newStatus;
      btn.dataset.status = newStatus;
      btn.textContent = newStatus === 'active' ? 'Disable' : 'Enable';
      const badge = row.querySelector('.badge');
      badge.className = `badge ${newStatus === 'active' ? 'badge-active' : 'badge-blocked'}`;
      badge.textContent = newStatus === 'active' ? 'Enabled' : 'Disabled';
    } else {
      btn.textContent = currentStatus === 'active' ? 'Disable' : 'Enable';
      window.showToast('Failed to update alias.', 'error');
    }
    btn.disabled = false;
  }

  function attachDeleteListeners() {
    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.removeEventListener('click', handleDelete);
      btn.addEventListener('click', handleDelete);
    });
  }

  async function handleDelete(e) {
    const btn = e.currentTarget;
    const address = btn.dataset.address;

    if (!btn.dataset.confirming) {
      btn.textContent = 'Confirm?';
      btn.dataset.confirming = 'true';
      setTimeout(() => {
        if (btn.dataset.confirming) {
          btn.textContent = 'Delete';
          delete btn.dataset.confirming;
        }
      }, 3000);
      return;
    }
    delete btn.dataset.confirming;

    btn.disabled = true;
    const res = await apiFetch(
      `/api/aliases/${encodeURIComponent(address)}`,
      'DELETE'
    );

    if (res.ok) {
      document.querySelector(`tr[data-address="${address}"]`)?.remove();
      window.showToast(`Alias ${address} deleted.`, 'success');
    } else {
      window.showToast('Failed to delete alias.', 'error');
      btn.disabled = false;
    }
  }

  attachToggleListeners();
  attachDeleteListeners();

  const overlay = document.getElementById('alias-modal-overlay');
  const modalClose = document.getElementById('alias-modal-close');
  const modalCancel = document.getElementById('alias-modal-cancel');
  const modalSubmit = document.getElementById('alias-modal-submit');
  const localInput = document.getElementById('new-alias-local');
  const expiresInput = document.getElementById('new-alias-expires');
  const modalError = document.getElementById('alias-modal-error');

  document.getElementById('btn-new-alias')?.addEventListener('click', () => {
    overlay?.classList.add('visible');
    overlay?.removeAttribute('aria-hidden');
    localInput?.focus();
  });

  function closeModal() {
    overlay?.classList.remove('visible');
    overlay?.setAttribute('aria-hidden', 'true');
    if (localInput) (localInput as HTMLInputElement).value = '';
    if (expiresInput) (expiresInput as HTMLInputElement).value = '';
    if (modalError) { modalError.hidden = true; modalError.textContent = ''; }
  }

  modalClose?.addEventListener('click', closeModal);
  modalCancel?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  modalSubmit?.addEventListener('click', async () => {
    const local = (localInput as HTMLInputElement).value.trim();
    const expires = (expiresInput as HTMLInputElement).value;
    const domain = document.getElementById('alias-modal-overlay')?.dataset.domain
      ?? window.location.hostname;

    if (!local) {
      if (modalError) { modalError.textContent = 'Address is required.'; modalError.hidden = false; }
      return;
    }

    const address = `${local}@${domain}`;
    const body: Record<string, unknown> = { address };
    if (expires) body.expires_at = Math.floor(new Date(expires).getTime() / 1000);

    (modalSubmit as HTMLButtonElement).disabled = true;
    if (modalError) modalError.hidden = true;

    const res = await apiFetch('/api/aliases', 'POST', body);
    const data = await res.json();

    if (res.ok) {
      closeModal();
      window.location.reload();
    } else {
      if (modalError) {
        modalError.textContent = data.error ?? 'Failed to create alias.';
        modalError.hidden = false;
      }
      (modalSubmit as HTMLButtonElement).disabled = false;
    }
  });

  initSegGroup('range-group', (btn) => {
    const range = btn.dataset.range;
    const stats = emailStats[range] ?? { total: 0, forwarded: 0, blocked: 0 };
    document.getElementById('stat-forwarded')!.textContent = stats.forwarded;
    document.getElementById('stat-blocked')!.textContent = stats.blocked;
    document.getElementById('stat-total')!.textContent = stats.total;
  });
</script>
